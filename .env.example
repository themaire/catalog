# Copier en .env et renseigner les valeurs (.env n'est jamais commité)

# MariaDB
DB_ROOT_PASSWORD=
DB_NAME=lib3d
DB_USER=catalog
DB_PASSWORD=

# Backend
# Générer avec : openssl rand -hex 32
JWT_SECRET=
# Dossier hôte des modèles (<catégorie>/<modèle dossier ou archive>), monté en lecture seule
MODELS_DIR=./modeles
# Scan planifié (syntaxe cron, vide = désactivé) et niveau d'accès des catégories créées par le scan (0 public, 1 modérateur, 2 admin)
SCAN_CRON=*/10 * * * *
SCAN_NEW_CATEGORY_LEVEL=1

# Frontend (Nginx), exposé sur le LAN
FRONTEND_PORT=8090

# Ports de debug (docker-compose.debug.yml uniquement), publiés sur 127.0.0.1
DB_HOST_PORT=3306
BACKEND_HOST_PORT=3080
